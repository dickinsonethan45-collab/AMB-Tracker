# Copy this to config.json for local dev (see README) or set these as
# Railway service Variables in production. Env vars always take priority
# over config.json when both are present.

BOT_TOKEN=your-discord-bot-token
ACCESS_TOKEN=OC|your-oculus-app-access-token|
DOC_ID=6771539532935162
OWNER_IDS=123456789012345678,987654321098765432
CHECK_INTERVAL=60
CONFIRMATIONS_REQUIRED=2

# Only needed if you attach a Railway Volume for persistent guilds.json
DATA_DIR=/data
