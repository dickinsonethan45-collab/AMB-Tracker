# Copy this file to .env for local testing and fill in real values.
# On Railway, set these same names under Project -> your service -> Variables
# instead — don't put real secrets in this file if it's committed to GitHub.

BOT_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
REDIRECT_URI=https://your-app.up.railway.app/discord-oauth-callback
ALERT_CHANNEL_ID=123456789012345678

# Optional — defaults shown
GROWTH_WINDOW_HOURS=25
MAX_TREE_LEVEL=1000
DATA_FILE=data.json

# Local only — Railway sets PORT for you automatically, don't set it there
PORT=8080
